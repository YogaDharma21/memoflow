{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      "@workspace/convex/api": ["../../packages/convex/convex/_generated/api"],
      "@workspace/convex/dataModel": ["../../packages/convex/convex/_generated/dataModel"],
      "@workspace/convex/server": ["../../packages/convex/convex/_generated/server"],
      "@workspace/convex": ["../../packages/convex/convex/_generated/api"],
      "@workspace/convex/*": ["../../packages/convex/convex/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "convex"]
}
