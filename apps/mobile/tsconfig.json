{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@workspace/convex/api": [
        "../../packages/convex/convex/_generated/api"
      ],
      "@workspace/convex/dataModel": [
        "../../packages/convex/convex/_generated/dataModel"
      ],
      "@workspace/convex/server": [
        "../../packages/convex/convex/_generated/server"
      ],
      "@workspace/convex": [
        "../../packages/convex/convex/_generated/api"
      ],
      "@workspace/convex/*": [
        "../../packages/convex/convex/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
